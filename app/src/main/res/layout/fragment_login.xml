<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark_gray"
        tools:context=".view.fragment.LoginFragment">

        <!-- Cabeza del perro: grande, arriba a la derecha y pegada al borde (HU 1.0 criterio 2) -->

        <!-- Título "DogApp": grande, blanco, bold y centrado debajo de la imagen (HU 1.0 criterio 3) -->

        <!-- Huella animada, abajo al centro (HU 1.0 criterio 4) -->

        <ImageView
            android:id="@+id/imgDogHead"
            android:layout_width="390dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="92dp"
            android:layout_marginEnd="-80dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitEnd"
            android:src="@drawable/dog_head"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:fontFamily="@font/fredoka"
            android:text="@string/dogApp"
            android:textColor="@color/white"
            android:textSize="72sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgDogHead" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animationFingerprint"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="76dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.536"
            app:layout_constraintStart_toStartOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/fingerprint" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
